[Interface]
Address = {{ item.address }}
PrivateKey = {{ (wireguard_key_contents.results | selectattr("item.name", "equalto", item.name) | first).content | b64decode | trim }}
{% if item.listen_port is defined %}ListenPort = {{ item.listen_port }}
{% endif %}{% for peer in item.peers | default([]) %}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') if peer.allowed_ips is sequence and peer.allowed_ips is not string else peer.allowed_ips }}
{% if peer.endpoint is defined %}Endpoint = {{ peer.endpoint }}
{% endif %}{% if peer.persistent_keepalive is defined %}PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}{% endfor %}
